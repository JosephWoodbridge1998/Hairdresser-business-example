<!-- ============ BOOKING ============ -->
<section class="section section-alt" id="booking">
  <div class="section-inner">
    <p class="kicker">Book Online</p>
    <h2>Book your appointment</h2>
    <p class="section-sub">Choose your service, pick a time, and we'll confirm by WhatsApp or email.</p>

    <form class="booking-form" id="bookingForm" novalidate>
      <div class="form-row">
        <div class="form-group">
          <label for="bkName">Name</label>
          <input type="text" id="bkName" name="name" required placeholder="Your full name">
          <span class="form-error" id="err-bkName">Please enter your name.</span>
        </div>
        <div class="form-group">
          <label for="bkEmail">Email</label>
          <input type="email" id="bkEmail" name="email" required placeholder="you@example.com">
          <span class="form-error" id="err-bkEmail">Please enter a valid email.</span>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="bkPhone">Phone</label>
          <input type="tel" id="bkPhone" name="phone" required placeholder="07xxx xxxxxx">
          <span class="form-error" id="err-bkPhone">Please enter a phone number.</span>
        </div>
        <div class="form-group">
          <label for="bkService">Service</label>
          <select id="bkService" name="service" required>
            <option value="" disabled selected>Choose a service…</option>
            <optgroup label="Cutting">
              <option>Cut &amp; Blow Dry (Ladies) — from £56</option>
              <option>Men's Wash &amp; Cut — from £35</option>
              <option>Students Female (under 25) — from £45</option>
              <option>Students Male (under 25) — from £31</option>
              <option>Children — from £30</option>
            </optgroup>
            <optgroup label="Styling">
              <option>Blow Dry — from £30</option>
            </optgroup>
            <optgroup label="Treatments">
              <option>Hair Treatments — from £17</option>
              <option>True Keratin Professional — from £160</option>
            </optgroup>
            <optgroup label="Colour">
              <option>Full Head Highlights — from £136</option>
              <option>Half Head Highlights — from £93</option>
              <option>Partial Highlights — from £62</option>
              <option>Full Head Tint — from £55</option>
              <option>Re-growth Tint — from £50</option>
              <option>Fashion Colour — £62</option>
              <option>Toner — £23</option>
              <option>Colour Correction — from £100</option>
              <option>Colour Correction Consultation — Free</option>
            </optgroup>
          </select>
          <span class="form-error" id="err-bkService">Please choose a service.</span>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="bkDate">Preferred date</label>
          <input type="date" id="bkDate" name="date" required>
          <span class="form-error" id="err-bkDate">Please pick a date.</span>
        </div>
        <div class="form-group">
          <label for="bkTime">Preferred time</label>
          <input type="time" id="bkTime" name="time" required>
          <span class="form-error" id="err-bkTime">Please pick a time.</span>
        </div>
      </div>

      <div class="form-group">
        <label for="bkNotes">Notes (optional)</label>
        <textarea id="bkNotes" name="notes" rows="3" placeholder="Anything we should know before your visit?"></textarea>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-lg">Request Appointment</button>
        <p class="form-hint">We'll confirm your slot by WhatsApp or email — this isn't an instant booking.</p>
      </div>

      <div class="form-confirmation" id="formConfirmation" role="status" aria-live="polite">
        <i class="fa-solid fa-circle-check"></i>
        <div>
          <strong>Request sent — thank you!</strong>
          <p>We've noted your details. Tap below to send us the same request directly on WhatsApp for a faster reply.</p>
          <a href="#" id="waConfirmLink" target="_blank" rel="noopener" class="btn btn-whatsapp btn-sm">
            <i class="fa-brands fa-whatsapp"></i> Send via WhatsApp
          </a>
        </div>
      </div>
    </form>
  </div>
</section>

