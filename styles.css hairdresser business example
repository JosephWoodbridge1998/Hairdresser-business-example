/* ==========================================================================
   Example Business — Stylesheet
   Palette: warm cream/beige background, deep charcoal text, muted rose-gold accent
   ========================================================================== */

:root{
  --cream:#FBF6EF;
  --cream-soft:#F3ECE1;
  --charcoal:#2B2622;
  --charcoal-soft:#6B6259;
  --accent:#B8896F;      /* muted rose-gold */
  --accent-dark:#9C6E56;
  --white:#FFFFFF;
  --line:#E6DDCF;
  --whatsapp:#25D366;
  --whatsapp-dark:#1DA851;

  --font-heading:'Playfair Display', Georgia, serif;
  --font-body:'Inter', -apple-system, Segoe UI, Roboto, sans-serif;

  --radius:12px;
  --shadow-soft:0 8px 24px rgba(43,38,34,0.08);
  --shadow-hover:0 16px 36px rgba(43,38,34,0.14);
}

*{ margin:0; padding:0; box-sizing:border-box; }

html{ scroll-behavior:smooth; }

body{
  font-family:var(--font-body);
  color:var(--charcoal);
  background:var(--cream);
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
}

img{ max-width:100%; display:block; }
a{ color:inherit; text-decoration:none; }
ul{ list-style:none; }

.section-inner, .nav-inner, .footer-inner{
  max-width:1140px;
  margin:0 auto;
  padding:0 24px;
}

h1,h2,h3{ font-family:var(--font-heading); font-weight:600; letter-spacing:-0.01em; color:var(--charcoal); }

/* ---------------- Buttons ---------------- */
.btn{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:12px 22px;
  border-radius:999px;
  font-weight:600;
  font-size:15px;
  border:1.5px solid transparent;
  cursor:pointer;
  transition:transform .15s ease, box-shadow .15s ease, background .15s ease;
  white-space:nowrap;
}
.btn:hover{ transform:translateY(-1px); }
.btn-lg{ padding:15px 28px; font-size:16px; }
.btn-sm{ padding:9px 16px; font-size:13.5px; }

.btn-primary{ background:var(--accent); color:var(--white); box-shadow:var(--shadow-soft); }
.btn-primary:hover{ background:var(--accent-dark); box-shadow:var(--shadow-hover); }

.btn-outline{ background:transparent; border-color:var(--charcoal); color:var(--charcoal); }
.btn-outline:hover{ background:var(--charcoal); color:var(--white); }

.btn-whatsapp{ background:var(--whatsapp); color:var(--white); }
.btn-whatsapp:hover{ background:var(--whatsapp-dark); }
.btn-whatsapp i{ font-size:18px; }

/* ---------------- Header ---------------- */
.site-header{
  position:sticky;
  top:0;
  z-index:100;
  background:rgba(251,246,239,0.92);
  backdrop-filter:blur(8px);
  border-bottom:1px solid var(--line);
  transition:padding .2s ease;
}
.nav-inner{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:20px 24px;
  transition:padding .2s ease;
}
.site-header.scrolled .nav-inner{ padding:12px 24px; }

.logo{ font-family:var(--font-heading); font-size:22px; font-weight:600; color:var(--charcoal); }
.logo span{ color:var(--accent); }

.nav-links{ display:flex; align-items:center; gap:32px; }
.nav-link{ font-size:15px; font-weight:500; color:var(--charcoal-soft); transition:color .15s; }
.nav-link:hover{ color:var(--accent); }

.nav-cta-desktop{ display:flex; gap:12px; align-items:center; }
.nav-cta-mobile{ display:none; }

.burger{
  display:none;
  flex-direction:column;
  gap:5px;
  background:none;
  border:none;
  cursor:pointer;
  padding:6px;
}
.burger span{ width:24px; height:2px; background:var(--charcoal); transition:transform .2s, opacity .2s; }
.burger.open span:nth-child(1){ transform:translateY(7px) rotate(45deg); }
.burger.open span:nth-child(2){ opacity:0; }
.burger.open span:nth-child(3){ transform:translateY(-7px) rotate(-45deg); }

@media (max-width:900px){
  .nav-cta-desktop{ display:none; }
  .burger{ display:flex; }
  .nav-links{
    position:fixed;
    inset:0 0 0 auto;
    top:0;
    width:min(82vw,360px);
    height:100vh;
    background:var(--cream);
    flex-direction:column;
    align-items:flex-start;
    justify-content:center;
    gap:26px;
    padding:40px;
    transform:translateX(100%);
    transition:transform .3s ease;
    box-shadow:-8px 0 30px rgba(0,0,0,.08);
  }
  .nav-links.open{ transform:translateX(0); }
  .nav-link{ font-size:20px; }
  .nav-cta-mobile{ display:flex; flex-direction:column; gap:12px; margin-top:14px; width:100%; }
  .nav-cta-mobile .btn{ justify-content:center; }
}

/* ---------------- Hero ---------------- */
.hero{
  padding:120px 24px 100px;
  background:linear-gradient(180deg, var(--cream) 0%, var(--cream-soft) 100%);
  text-align:center;
}
.hero-inner{ max-width:760px; margin:0 auto; }
.eyebrow{
  font-size:13.5px;
  font-weight:600;
  letter-spacing:.04em;
  color:var(--accent-dark);
  margin-bottom:18px;
}
.hero h1{
  font-size:clamp(32px, 5vw, 52px);
  line-height:1.15;
  margin-bottom:20px;
}
.hero-sub{
  font-size:17px;
  color:var(--charcoal-soft);
  max-width:52ch;
  margin:0 auto 36px;
}
.hero-ctas{ display:flex; gap:14px; justify-content:center; flex-wrap:wrap; }

/* ---------------- Sections (shared) ---------------- */
.section{ padding:96px 0; }
.section-alt{ background:var(--cream-soft); }

.kicker{
  font-size:13.5px;
  font-weight:600;
  letter-spacing:.04em;
  color:var(--accent-dark);
  margin-bottom:12px;
  text-transform:uppercase;
}
.section-inner > h2{ font-size:clamp(28px,3.6vw,38px); margin-bottom:14px; }
.section-sub{ color:var(--charcoal-soft); font-size:16px; max-width:56ch; margin-bottom:44px; }

/* ---------------- About ---------------- */
.about-text{ max-width:70ch; font-size:16.5px; color:var(--charcoal-soft); margin-bottom:20px; }
.about-lead{ font-weight:600; color:var(--charcoal); margin-bottom:48px; }

.stats-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:20px;
}
.stat-card{
  background:var(--white);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:28px 20px;
  text-align:center;
  box-shadow:var(--shadow-soft);
}
.stat-num{ display:block; font-family:var(--font-heading); font-size:26px; color:var(--accent-dark); margin-bottom:6px; }
.stat-label{ font-size:13.5px; color:var(--charcoal-soft); }

@media (max-width:760px){ .stats-grid{ grid-template-columns:repeat(2,1fr); } }

/* ---------------- Services Menu ---------------- */
.menu-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:44px 56px;
}
@media (max-width:900px){ .menu-grid{ grid-template-columns:1fr; } }

.menu-cat-title{
  font-size:20px;
  padding-bottom:12px;
  margin-bottom:18px;
  border-bottom:2px solid var(--accent);
  display:inline-block;
}

.menu-row{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:16px;
  padding:16px 0;
  border-bottom:1px solid var(--line);
  transition:background .15s;
}
.menu-row:hover{ background:rgba(184,137,111,0.06); }
.menu-row:last-child{ border-bottom:none; }

.menu-row-main{ display:flex; flex-direction:column; gap:4px; }
.menu-name{ font-weight:600; font-size:15.5px; }
.menu-desc{ font-size:13.5px; color:var(--charcoal-soft); max-width:36ch; }

.menu-row-meta{ display:flex; flex-direction:column; align-items:flex-end; gap:4px; flex-shrink:0; }
.menu-time{ font-size:12.5px; color:var(--charcoal-soft); }
.menu-price{ font-weight:700; color:var(--accent-dark); font-size:15px; }

/* ---------------- Products ---------------- */
.products-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:24px;
}
.product-card{
  background:var(--white);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:28px;
  box-shadow:var(--shadow-soft);
  transition:transform .18s, box-shadow .18s;
}
.product-card:hover{ transform:translateY(-4px); box-shadow:var(--shadow-hover); }
.product-img{
  width:56px; height:56px;
  border-radius:50%;
  background:var(--cream-soft);
  display:flex; align-items:center; justify-content:center;
  margin-bottom:18px;
  color:var(--accent-dark);
  font-size:22px;
}
.product-card h3{ font-size:17px; margin-bottom:8px; }
.product-card p{ font-size:14px; color:var(--charcoal-soft); margin-bottom:20px; }

/* ---------------- Booking Form ---------------- */
.booking-form{
  max-width:720px;
  background:var(--white);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:40px;
  box-shadow:var(--shadow-soft);
}
.form-row{ display:grid; grid-template-columns:1fr 1fr; gap:20px; }
@media (max-width:640px){ .form-row{ grid-template-columns:1fr; } }

.form-group{ margin-bottom:20px; display:flex; flex-direction:column; }
.form-group label{ font-size:13.5px; font-weight:600; margin-bottom:8px; color:var(--charcoal); }
.form-group input,
.form-group select,
.form-group textarea{
  padding:12px 14px;
  border:1.5px solid var(--line);
  border-radius:8px;
  font-family:var(--font-body);
  font-size:15px;
  background:var(--cream);
  color:var(--charcoal);
  transition:border-color .15s, box-shadow .15s;
}
.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus{
  outline:none;
  border-color:var(--accent);
  box-shadow:0 0 0 3px rgba(184,137,111,0.18);
  background:var(--white);
}
.form-group textarea{ resize:vertical; }

.form-error{
  display:none;
  font-size:12.5px;
  color:#B3261E;
  margin-top:6px;
}
.form-group.invalid input,
.form-group.invalid select{ border-color:#B3261E; }
.form-group.invalid .form-error{ display:block; }

.form-actions{ margin-top:8px; }
.form-hint{ font-size:13px; color:var(--charcoal-soft); margin-top:10px; }

.form-confirmation{
  display:none;
  gap:14px;
  align-items:flex-start;
  margin-top:28px;
  padding:20px;
  background:var(--cream-soft);
  border:1px solid var(--line);
  border-radius:var(--radius);
}
.form-confirmation.show{ display:flex; }
.form-confirmation i{ color:var(--whatsapp); font-size:22px; margin-top:2px; }
.form-confirmation p{ font-size:14px; color:var(--charcoal-soft); margin:6px 0 14px; }

/* ---------------- Find Us / Contact ---------------- */
.contact-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:48px;
  align-items:start;
}
@media (max-width:900px){ .contact-grid{ grid-template-columns:1fr; } }

.contact-list{ margin-bottom:28px; }
.contact-list li{
  display:flex; align-items:center; gap:12px;
  padding:10px 0;
  font-size:15.5px;
  border-bottom:1px solid var(--line);
}
.contact-list li:first-child{ border-top:1px solid var(--line); }
.contact-list i{ color:var(--accent-dark); width:18px; }
.contact-list em{ color:var(--charcoal-soft); font-style:normal; font-size:13px; }

.hours-table{ width:100%; border-collapse:collapse; margin-bottom:28px; }
.hours-table td{ padding:8px 0; font-size:14.5px; border-bottom:1px solid var(--line); }
.hours-table td:first-child{ color:var(--charcoal-soft); }
.hours-table td:last-child{ text-align:right; font-weight:600; }

.contact-ctas{ display:flex; gap:12px; flex-wrap:wrap; }

.map-placeholder{
  height:100%;
  min-height:280px;
  background:var(--cream-soft);
  border:1px dashed var(--line);
  border-radius:var(--radius);
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:10px;
  color:var(--charcoal-soft);
}
.map-placeholder i{ font-size:34px; color:var(--accent); }

/* ---------------- Footer ---------------- */
.site-footer{ background:var(--charcoal); color:#D8D1C7; padding:56px 0 0; margin-top:60px; }
.footer-inner{
  display:grid;
  grid-template-columns:1.4fr 1fr 1fr;
  gap:32px;
  padding-bottom:36px;
}
@media (max-width:760px){ .footer-inner{ grid-template-columns:1fr; } }

.footer-logo{ color:var(--white); }
.footer-logo span{ color:var(--accent); }
.footer-tagline{ font-size:14px; color:#A79E92; margin-top:12px; max-width:32ch; }

.footer-links{ display:flex; flex-direction:column; gap:10px; }
.footer-links a{ font-size:14.5px; color:#D8D1C7; }
.footer-links a:hover{ color:var(--accent); }

.footer-social span{ font-size:14.5px; color:#D8D1C7; }

.footer-bottom{
  border-top:1px solid rgba(255,255,255,0.1);
  padding:20px 24px;
  text-align:center;
  font-size:13px;
  color:#8A8177;
}
